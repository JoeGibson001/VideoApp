# Copy to .env and fill in. Never commit .env.

# ---- shared ----
# Timezone for logs and the daily watch run
TZ=Australia/Sydney
# Importer -> App ingest auth (long random string, same value for both services)
INGEST_API_KEY=change-me-ingest
# Auth for the Importer API (App admin proxy, scripts, iOS Shortcuts)
IMPORTER_API_KEY=change-me-importer

# ---- app ----
# Initial admin password (required on first run; ignored once the admin exists)
ADMIN_PASSWORD=
# Secret used to derive session ids (long random string)
SESSION_SECRET=change-me-session
# Session lifetime in days
SESSION_DAYS=30
# Secure cookies need HTTPS. Set false only for plain-http local testing.
COOKIE_SECURE=true
# Importer base URL as seen from the app container
IMPORTER_URL=http://importer:8081
# Login attempts per IP per window
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_S=300
# Feed weights (DESIGN.md 5.5)
FEED_K=5
FEED_W_TAG=1.0
FEED_W_CREATOR=0.8
FEED_W_SOURCE=0.2
FEED_W_FRESH=0.2
FEED_W_RANDOM=0.5
# Freshness decay in days, exploration slot frequency, candidate pool size
FEED_FRESH_DAYS=30
FEED_EXPLORE_EVERY=5
FEED_CANDIDATES=500

# ---- importer ----
# App base URL as seen from the importer container
APP_INTERNAL_URL=http://app:8080
# Parallel downloads
IMPORT_CONCURRENCY=2
# Daily watch run time (HH:MM in TZ), listing and queue limits
WATCH_RUN_TIME=03:00
WATCH_SCAN_LIMIT=100
WATCH_MAX_PER_RUN=50
WATCH_BACKFILL_MAX=500
# Transcode non H.264/AAC downloads for iOS compatibility
TRANSCODE_INCOMPATIBLE=true
# Import limits (0 = no limit)
MAX_FILE_MB=4096
MAX_DURATION_MIN=240
# Update yt-dlp on container start
YTDLP_AUTO_UPDATE=false
# Optional Netscape cookies file for sites that need a login (used only if it exists)
YTDLP_COOKIES_FILE=/data/cookies.txt
LOG_LEVEL=INFO
