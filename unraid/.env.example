# Tastebud on Unraid: paste this into the stack's env file (Compose Manager > Edit Stack > Env File)
# and fill in the four secrets. Generate each one in the Unraid terminal with:
#   openssl rand -hex 32
# Keep comments on their own lines (never after a value).

# ---- required ----
# First login is user "admin" with this password (only used when no admin exists yet).
ADMIN_PASSWORD=
SESSION_SECRET=
INGEST_API_KEY=
IMPORTER_API_KEY=

# ---- where things live on the server ----
# Databases: keep this share on the cache drive.
APPDATA_PATH=/mnt/user/appdata/tastebud
# Videos, posters and metadata: can live on the array.
MEDIA_PATH=/mnt/user/media/tastebud
# Port on the Unraid host.
APP_PORT=8080
# "latest", or pin a version such as 1.2.0 or sha-abc1234.
TASTEBUD_TAG=latest

# ---- HTTPS / cookies ----
# true when you reach Tastebud through SWAG over https (needed to install the app on phones).
# Set to false ONLY while testing over plain http://<unraid-ip>:8080, or logging in will not stick.
COOKIE_SECURE=true

# ---- general ----
TZ=Australia/Sydney
SESSION_DAYS=30

# ---- importer ----
IMPORT_CONCURRENCY=2
WATCH_RUN_TIME=03:00
WATCH_SCAN_LIMIT=100
WATCH_MAX_PER_RUN=50
WATCH_BACKFILL_MAX=500
TRANSCODE_INCOMPATIBLE=true
MAX_FILE_MB=4096
MAX_DURATION_MIN=240
# Update yt-dlp every time the importer starts (sites change often).
YTDLP_AUTO_UPDATE=true
# Optional: <APPDATA_PATH>/importer/cookies.txt, used only if the file exists.
YTDLP_COOKIES_FILE=/data/cookies.txt
LOG_LEVEL=INFO
